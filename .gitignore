# NetworkLab: generated Python files (never source code)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
htmlcov/
*.egg-info/
build/
dist/

# Local Python environments
.venv/
venv/
env/

# NetworkLab runtime data (not repository source or tracked fixtures)
/.networklab/
/results/
/logs/
/tmp/
*.log

# Local secrets and credentials (defence in depth, not a secret scanner)
.env
.env.*
!.env.example
!.env.sample
*.pem
*.p12
*.pfx
id_rsa
id_ed25519

# macOS, editors and temporary files
.DS_Store
._*
.AppleDouble
.LSOverride
.idea/
.vscode/
*.swp
*.swo
*~

# Locally generated archive assets; .sha256 files are not excluded
*.zip
